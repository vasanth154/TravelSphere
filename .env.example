# TravelSphere Environment Variables

# Backend
BACKEND_CORS_ORIGINS="http://localhost:3000"
SECRET_KEY="change-this-to-a-strong-random-value"
ALGORITHM="bcrypt"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL="postgresql://travelsphere:password@localhost:5432/travelsphere"

# AI (optional, when available)
OPENROUTER_API_KEY="your-openrouter-key-here"

# Amadeus Hotel API (REQUIRED for real-time hotel search)
# Get free test credentials from https://developers.amadeus.com/
# When these are set, TravelSphere searches real hotels worldwide via:
#   1. Hotel List by Geocode  (destination -> lat/long -> hotel IDs)
#   2. Hotel Search V3        (hotel IDs + dates + guests -> live offers)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_BASE_URL="https://test.api.amadeus.com"  # Use https://api.amadeus.com for production

# Hotel provider configuration
# If AMADEUS_CLIENT_ID / AMADEUS_CLIENT_SECRET are NOT set, the /api/hotels
# endpoints return a clear "not configured" message instead of fake data.
# For LOCAL DEVELOPMENT ONLY (never in production), you may enable synthetic
# data by setting HOTEL_PROVIDER=mock. This is never used as a silent fallback.
# HOTEL_PROVIDER=mock

# TRANSPORT_PROVIDER_A_KEY=""
# TRANSPORT_PROVIDER_B_KEY=""

# Weather (optional, when available)
# Without a key the backend uses a deterministic mock provider, so the
# weather-aware features still work end-to-end in development/demos.
WEATHER_API_KEY=""
# Optional OpenWeatherMap base URL override (defaults to https://api.openweathermap.org)
# WEATHER_API_BASE_URL=""
# Forecast cache TTL in seconds (default 1800 = 30 minutes)
# WEATHER_CACHE_TTL="1800"

# Admin initialization (development only)
# Admin user will be created on startup if ADMIN_EMAIL doesn't exist
ADMIN_EMAIL="admin@travelsphere.com"
ADMIN_PASSWORD="change-this-for-local-development"

# Application
ENVIRONMENT="development"  # production | development | staging
DEBUG="true"  # false for production